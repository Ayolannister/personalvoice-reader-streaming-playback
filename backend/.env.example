# Copy to backend/.env for running the backend outside Docker.
# Inside Docker, docker/docker-compose.yml sets these for you.

# dummy = fake silent audio (fast, no model needed)
# xtts_remote = real cloning via worker/tts-service
TTS_ENGINE=xtts_remote
TTS_SERVICE_URL=http://127.0.0.1:8001

# Leave unset to use SQLite. Postgres example:
# DATABASE_URL=postgresql+psycopg://pvreader:pvreader@localhost:5432/pvreader
